# ==============================================================================
# Chess Evolve - Environment Configuration Template (.env.example)
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Allowed CORS Origins (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend Public Variables (Vite bundles these client-side)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-supabase-anon-key
VITE_API_BASE_URL=/api/v1

# Supabase Server Configuration (Never expose SERVICE_ROLE_KEY to frontend)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-public-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-private-supabase-service-role-key

# PostgreSQL Connection Strings
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true
DIRECT_DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Redis Connection (Required for BullMQ queues & rate limiting)
REDIS_URL=redis://localhost:6379

# External Chess.com Public API Base URL
CHESS_API_BASE_URL=https://api.chess.com/pub

# ML Service Configuration
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_PORT=8000
ML_SERVICE_AUTH_SECRET=your-shared-ml-service-auth-secret
MODEL_STORAGE_PATH=./artifacts

# Stockfish Engine Binary Path
STOCKFISH_PATH=/usr/local/bin/stockfish

# Optional AI Coaching LLM
OPENAI_API_KEY=your-openai-api-key
