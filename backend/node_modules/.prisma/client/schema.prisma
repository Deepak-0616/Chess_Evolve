datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SyncStatus {
  IDLE
  SYNCING
  COMPLETED
  FAILED
}

enum MoveClassification {
  BEST
  GOOD
  INACCURACY
  MISTAKE
  BLUNDER
}

enum GamePhase {
  OPENING
  MIDDLEGAME
  ENDGAME
}

enum ModelType {
  CURRENT_SELF
  PEAK_SELF
}

enum ModelStatus {
  NOT_AVAILABLE
  INSUFFICIENT_DATA
  QUEUED
  TRAINING
  VALIDATING
  READY
  ACTIVE
  SUPERSEDED
  REJECTED
  FAILED
}

enum PlaySessionStatus {
  IN_PROGRESS
  USER_WON
  MODEL_WON
  DRAW
  RESIGNED
}

enum ArenaVisibility {
  PRIVATE
  DISCOVERABLE
  PUBLIC
}

model User {
  id          String   @id // Matches Supabase Auth User UUID
  email       String?
  displayName String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chessProfile          ChessProfile?
  dnaVersions           ChessDNAVersion[]
  currentDna            ChessDNA?
  modelVersions         MLModelVersion[]
  trainingPlans         TrainingPlan[]
  trainingSessions      TrainingSession[]
  trainingPositions     TrainingPosition[]
  trainingAttempts      TrainingAttempt[]
  trainingProgress      TrainingProgress?
  playSessions          PlaySession[]
  arenaProfile          ArenaProfile?
  featureJobs           FeatureGenerationJob[]
  featureDatasets       FeatureDataset[]
  featureRecords        FeatureRecord[]
  datasetJobs           DatasetGenerationJob[]
  datasets              MLDataset[]
  datasetRecords        MLDatasetRecord[]
  coachConversations    CoachConversation[]
  coachMessages         CoachMessage[]
  evolutionSnapshots    EvolutionSnapshot[]
  modelUpdateCandidates ModelUpdateCandidate[]
  retrainingJobs        ModelRetrainingJob[]
}

model ChessProfile {
  id            String     @id @default(cuid())
  userId        String     @unique
  chessUsername String
  playerUrl     String?
  title         String?
  avatarUrl     String?
  country       String?
  followers     Int?
  joinedAt      DateTime?
  lastSyncedAt  DateTime?
  syncStatus    SyncStatus @default(IDLE)
  syncProgress  Json? // Stores job state, processed games/archives count
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  games Game[]
}

model Game {
  id               String   @id // External Chess.com game id or deterministic hash
  chessProfileId   String
  url              String?
  pgn              String   @db.Text
  timeControl      String
  timeClass        String // bullet, blitz, rapid, daily
  rated            Boolean  @default(true)
  whiteUsername    String
  whiteRating      Int
  blackUsername    String
  blackRating      Int
  userColor        String // WHITE or BLACK
  userRating       Int
  opponentUsername String
  opponentRating   Int
  result           String // WIN, LOSS, DRAW
  endReason        String?
  playedAt         DateTime
  analyzed         Boolean  @default(false)
  createdAt        DateTime @default(now())

  chessProfile     ChessProfile       @relation(fields: [chessProfileId], references: [id], onDelete: Cascade)
  gameAnalysis     GameAnalysis?
  positionAnalyses PositionAnalysis[]

  @@index([chessProfileId, playedAt])
}

model GameAnalysis {
  id                 String   @id @default(cuid())
  gameId             String   @unique
  accuracy           Float
  avgCpLoss          Float
  inaccuracies       Int
  mistakes           Int
  blunders           Int
  openingName        String?
  openingEco         String?
  openingAccuracy    Float?
  middlegameAccuracy Float?
  endgameAccuracy    Float?
  createdAt          DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model PositionAnalysis {
  id              String             @id @default(cuid())
  gameId          String
  moveNumber      Int
  ply             Int
  fen             String
  move            String
  playerMove      Boolean // True if made by connected user
  evalBefore      Float
  evalAfter       Float
  cpLoss          Float
  bestMove        String
  candidateMoves  Json // Array of top K Stockfish candidates with evals
  classification  MoveClassification
  gamePhase       GamePhase
  materialBalance Float
  kingSafetyScore Float
  tacticalScore   Float
  positionalScore Float
  createdAt       DateTime           @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, ply])
}

model ChessDNA {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  version                  Int      @default(1)
  aggression               Float
  riskTaking               Float
  tacticalPreference       Float
  positionalPreference     Float
  defensiveAbility         Float
  sacrificeTendency        Float
  tradingTendency          Float
  openingDiversity         Float
  endgameAbility           Float
  kingSafety               Float
  attackPreference         Float
  simplificationPreference Float
  timePressureBehavior     Float
  topStrengths             Json // Array of strength descriptors
  topWeaknesses            Json // Array of weakness descriptors
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChessDNAVersion {
  id                       String   @id @default(cuid())
  userId                   String
  version                  Int
  aggression               Float
  riskTaking               Float
  tacticalPreference       Float
  positionalPreference     Float
  defensiveAbility         Float
  sacrificeTendency        Float
  tradingTendency          Float
  openingDiversity         Float
  endgameAbility           Float
  kingSafety               Float
  attackPreference         Float
  simplificationPreference Float
  timePressureBehavior     Float
  createdAt                DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
}

model MLModelVersion {
  id                      String      @id @default(cuid())
  userId                  String
  modelType               ModelType
  version                 Int
  dnaVersion              Int?
  datasetVersion          String      @default("v1")
  featureVersion          String      @default("v1")
  architectureVersion     String      @default("v1")
  trainingConfigVersion   String      @default("v1")
  dependentModelVersionId String? // Used by Peak Self to reference Current Self version used during training/inference
  trainingJobId           String?
  gamesUsed               Int         @default(0)
  positionsUsed           Int         @default(0)
  status                  ModelStatus @default(NOT_AVAILABLE)
  metrics                 Json? // { accuracy, top3Accuracy, valLoss, epochCount, mrr }

  // Evaluation & Quality Gate
  evaluationStatus       String?   @default("PENDING")
  evaluationMetrics      Json?
  behavioralMetrics      Json?
  baselineMetrics        Json?
  qualityGateResult      Json?
  evaluationArtifactPath String?
  evaluationCompletedAt  DateTime?

  artifactPath     String?
  artifactChecksum String?
  trainedAt        DateTime?
  isActive         Boolean   @default(false)
  activatedAt      DateTime?
  supersededAt     DateTime?
  createdAt        DateTime  @default(now())

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  playSessions      PlaySession[]
  arenaModels       ArenaModel[]
  whiteArenaMatches ArenaMatch[]  @relation("WhiteMatchModel")
  blackArenaMatches ArenaMatch[]  @relation("BlackMatchModel")

  // Self relation for dependencies
  dependentModel  MLModelVersion?  @relation("ModelDependency", fields: [dependentModelVersionId], references: [id])
  dependingModels MLModelVersion[] @relation("ModelDependency")

  @@unique([userId, modelType, version])
  @@index([userId, modelType, isActive])
  @@index([userId, status])
}

model TrainingPlan {
  id                    String    @id @default(cuid())
  userId                String
  version               Int       @default(1)
  status                String    @default("ACTIVE") // ACTIVE, COMPLETED, ARCHIVED
  focusCategory         String
  targetWeakness        String
  difficulty            String    @default("INTERMEDIATE") // NOVICE, INTERMEDIATE, ADVANCED, EXPERT
  generatedAt           DateTime  @default(now())
  expiresAt             DateTime?
  sourceAnalysisVersion String?   @default("v1")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions  TrainingSession[]
  positions TrainingPosition[]

  @@index([userId, status])
}

model TrainingSession {
  id                 String    @id @default(cuid())
  userId             String
  trainingPlanId     String?
  targetWeakness     String
  title              String
  description        String
  category           String    @default("TACTICAL")
  difficulty         String    @default("INTERMEDIATE")
  positionsPlanned   Int       @default(5)
  positionsCompleted Int       @default(0)
  score              Float?
  status             String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, ABANDONED
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingPlan TrainingPlan?      @relation(fields: [trainingPlanId], references: [id], onDelete: SetNull)
  positions    TrainingPosition[]
  attempts     TrainingAttempt[]

  @@index([userId, status])
}

model TrainingPosition {
  id                     String   @id @default(cuid())
  userId                 String
  trainingPlanId         String?
  trainingSessionId      String?
  gameId                 String
  positionAnalysisId     String?
  moveNumber             Int
  fen                    String
  sideToMove             String // WHITE or BLACK
  weaknessCategory       String
  weaknessScore          Float    @default(0.0)
  recurrenceScore        Float    @default(1.0)
  priorityScore          Float    @default(0.0)
  difficulty             String   @default("INTERMEDIATE")
  targetMove             String // Authoritative best move
  targetMoveUci          String?
  playerHistoricalMove   String? // Move the player originally played
  playerHistoricalClass  String? // BLUNDER, MISTAKE, INACCURACY
  playerHistoricalCpLoss Float?
  candidateMoves         Json // Array of candidate objects [{move, rank, score, ...}]
  metadata               Json? // Context, tags, explanation notes
  orderIndex             Int      @default(0)
  createdAt              DateTime @default(now())

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingPlan    TrainingPlan?     @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  trainingSession TrainingSession?  @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  attempts        TrainingAttempt[]

  @@index([userId, weaknessCategory])
  @@index([trainingSessionId])
}

model TrainingAttempt {
  id                    String   @id @default(cuid())
  userId                String
  trainingSessionId     String
  trainingPositionId    String
  submittedMove         String
  submittedMoveUci      String?
  isCorrect             Boolean
  quality               String // BEST, EXCELLENT, GOOD, INACCURACY, MISTAKE, BLUNDER
  engineRank            Int?
  cpLoss                Float?
  currentSelfMove       String?
  currentSelfConfidence Float?
  currentSelfRank       Int?
  peakSelfMove          String?
  peakSelfConfidence    Float?
  peakSelfRank          Int?
  explanation           String?  @db.Text
  timeSpentMs           Int?
  attemptedAt           DateTime @default(now())

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingSession  TrainingSession  @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  trainingPosition TrainingPosition @relation(fields: [trainingPositionId], references: [id], onDelete: Cascade)

  @@index([userId, attemptedAt])
  @@index([trainingSessionId])
}

model TrainingProgress {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  totalSessionsCompleted  Int       @default(0)
  totalPositionsAttempted Int       @default(0)
  totalPositionsSolved    Int       @default(0)
  overallSuccessRate      Float     @default(0.0)
  categoryPerformance     Json      @default("{}") // { [category]: { attempted, solved, successRate, avgCpLoss } }
  weaknessProgression     Json      @default("{}") // { [weakness]: { initialScore, currentScore, trend } }
  currentDifficulty       String    @default("INTERMEDIATE")
  streakDays              Int       @default(0)
  lastTrainingDate        DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlaySession {
  id                      String            @id @default(cuid())
  userId                  String
  opponentModelType       ModelType
  opponentModelVersionId  String?
  dependentModelVersionId String? // For Peak Self, store which Current Self version was used
  userColor               String // WHITE or BLACK
  fen                     String            @default("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1")
  pgn                     String            @default("") @db.Text
  moveHistory             Json // Array of moves made in session
  status                  PlaySessionStatus @default(IN_PROGRESS)
  result                  String? // USER_WIN, CURRENT_SELF_WIN, DRAW
  terminationReason       String? // CHECKMATE, STALEMATE, RESIGNATION, etc.
  completedAt             DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  opponentModelVersion MLModelVersion? @relation(fields: [opponentModelVersionId], references: [id])
}

model ArenaProfile {
  id           String          @id @default(cuid())
  userId       String          @unique
  displayName  String?
  visibility   ArenaVisibility @default(PRIVATE)
  arenaEnabled Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  models             ArenaModel[]
  ratings            ArenaRating[]
  matchesAsWhite     ArenaMatch[]     @relation("WhitePlayer")
  matchesAsBlack     ArenaMatch[]     @relation("BlackPlayer")
  challengesSent     ArenaChallenge[] @relation("Challenger")
  challengesReceived ArenaChallenge[] @relation("Opponent")
}

model ArenaModel {
  id               String          @id @default(cuid())
  userId           String
  mlModelVersionId String
  modelType        ModelType
  visibility       ArenaVisibility @default(PRIVATE)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  arenaProfile   ArenaProfile   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  mlModelVersion MLModelVersion @relation(fields: [mlModelVersionId], references: [id], onDelete: Cascade)

  @@unique([userId, modelType])
}

model ArenaRating {
  id          String    @id @default(cuid())
  userId      String
  modelType   ModelType
  rating      Int       @default(1500)
  gamesPlayed Int       @default(0)
  wins        Int       @default(0)
  losses      Int       @default(0)
  draws       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  arenaProfile ArenaProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, modelType])
}

model ArenaMatch {
  id                  String            @id @default(cuid())
  status              PlaySessionStatus @default(IN_PROGRESS)
  whiteUserId         String
  whiteModelVersionId String? // Null if human
  blackUserId         String
  blackModelVersionId String? // Null if human
  timeControl         String            @default("10+0")
  result              String?
  winnerUserId        String?
  terminationReason   String?
  pgn                 String            @default("") @db.Text
  fen                 String            @default("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1")
  moveHistory         Json              @default("[]")
  startedAt           DateTime          @default(now())
  completedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  whiteProfile      ArenaProfile    @relation("WhitePlayer", fields: [whiteUserId], references: [userId])
  blackProfile      ArenaProfile    @relation("BlackPlayer", fields: [blackUserId], references: [userId])
  whiteModelVersion MLModelVersion? @relation("WhiteMatchModel", fields: [whiteModelVersionId], references: [id])
  blackModelVersion MLModelVersion? @relation("BlackMatchModel", fields: [blackModelVersionId], references: [id])
}

enum ChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

model ArenaChallenge {
  id                       String          @id @default(cuid())
  challengerUserId         String
  challengerModelVersionId String?
  opponentUserId           String
  opponentModelVersionId   String
  timeControl              String          @default("10+0")
  status                   ChallengeStatus @default(PENDING)
  expiresAt                DateTime
  createdAt                DateTime        @default(now())

  challengerProfile ArenaProfile @relation("Challenger", fields: [challengerUserId], references: [userId])
  opponentProfile   ArenaProfile @relation("Opponent", fields: [opponentUserId], references: [userId])
}

enum FeatureGenerationStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

model FeatureGenerationJob {
  id                        String                  @id @default(cuid())
  userId                    String
  status                    FeatureGenerationStatus @default(PENDING)
  featureVersion            String                  @default("v1")
  gamesTotal                Int                     @default(0)
  gamesProcessed            Int                     @default(0)
  positionsTotal            Int                     @default(0)
  positionsProcessed        Int                     @default(0)
  candidateRecordsGenerated Int                     @default(0)
  failedRecords             Int                     @default(0)
  startedAt                 DateTime?
  completedAt               DateTime?
  error                     String?                 @db.Text
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FeatureDataset {
  id             String   @id @default(cuid())
  userId         String
  featureVersion String   @default("v1")
  gameCount      Int      @default(0)
  positionCount  Int      @default(0)
  candidateCount Int      @default(0)
  status         String   @default("READY")
  createdAt      DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  records FeatureRecord[]

  @@unique([userId, featureVersion])
}

model FeatureRecord {
  id               String  @id @default(cuid())
  featureDatasetId String
  userId           String
  gameId           String
  positionId       String // Maps to PositionAnalysis ID
  moveNumber       Int
  candidateMove    String
  isActualMove     Boolean
  featureVersion   String

  // Stored conceptually as JSON for flexibility across dimensions
  position  Json
  candidate Json
  player    Json
  history   Json
  weakness  Json
  dna       Json?

  createdAt DateTime @default(now())

  dataset FeatureDataset @relation(fields: [featureDatasetId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, positionId, candidateMove, featureVersion])
  @@index([userId, featureVersion])
  @@index([gameId])
}

enum DatasetStatus {
  PENDING
  RUNNING
  VALIDATING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum DatasetType {
  CURRENT_SELF
  PEAK_SELF
}

model DatasetGenerationJob {
  id             String        @id @default(cuid())
  userId         String
  status         DatasetStatus @default(PENDING)
  datasetType    DatasetType
  datasetVersion String        @default("v1")
  featureVersion String
  targetVersion  String        @default("v1")

  totalRecords     Int @default(0)
  processedRecords Int @default(0)
  excludedRecords  Int @default(0)

  startedAt   DateTime?
  completedAt DateTime?
  error       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MLDataset {
  id             String      @id @default(cuid())
  userId         String
  datasetType    DatasetType
  version        String
  featureVersion String
  targetVersion  String
  schemaVersion  String      @default("v1")

  totalGames     Int @default(0)
  totalPositions Int @default(0)
  totalRecords   Int @default(0)

  trainRecords      Int @default(0)
  validationRecords Int @default(0)
  testRecords       Int @default(0)
  excludedRecords   Int @default(0)

  status           DatasetStatus @default(COMPLETED)
  validationReport Json?
  statistics       Json?
  exclusionReasons Json?

  createdAt DateTime @default(now())

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  records MLDatasetRecord[]

  @@unique([userId, datasetType, version])
}

model MLDatasetRecord {
  id         String @id @default(cuid())
  datasetId  String
  userId     String
  gameId     String
  positionId String
  moveNumber Int
  split      String // "TRAIN", "VALIDATION", "TEST"

  // Data
  candidateMove String
  actualMove    String
  isActualMove  Boolean
  isPeakTarget  Boolean @default(false)
  peakScore     Float?

  // Stored for easy artifact generation without complex joins
  features Json
  metadata Json

  createdAt DateTime @default(now())

  dataset MLDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([datasetId, split])
  @@index([gameId])
}

model CoachConversation {
  id          String   @id @default(cuid())
  userId      String
  title       String?
  contextType String? // e.g. "GENERAL", "GAME_REVIEW", "EVOLUTION"
  gameId      String? // Reference to Game if applicable
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages CoachMessage[]

  @@index([userId])
}

model CoachMessage {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  role           String // "user" or "assistant"
  content        String   @db.Text
  metadata       Json? // Extra structured info (insights, evidence, etc)
  createdAt      DateTime @default(now())

  conversation CoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model EvolutionSnapshot {
  id                  String    @id @default(cuid())
  userId              String
  snapshotDate        DateTime  @default(now())
  sourceType          String // "BASELINE", "COHORT", "POST_TRAINING", "CURRENT"
  cohortName          String? // e.g. "Baseline (Pre-Training)", "Recent Cohort"
  startGameDate       DateTime?
  endGameDate         DateTime?
  gamesAnalyzed       Int       @default(0)
  positionsAnalyzed   Int       @default(0)
  sampleSizeDecisions Int       @default(0)

  // Longitudinal Gameplay Metrics
  avgCPL         Float  @default(0.0)
  medianCPL      Float?
  blunderRate    Float  @default(0.0) // blunders / decisions
  mistakeRate    Float  @default(0.0) // mistakes / decisions
  inaccuracyRate Float  @default(0.0) // inaccuracies / decisions
  engineTop1Rate Float? // moves matching engine top 1
  engineTop3Rate Float? // moves matching engine top 3
  avgEngineRank  Float?

  // Category-specific CPL & frequencies (JSON)
  categoryMetrics Json? // { [category]: { avgCpl, errorRate, sampleSize } }

  // Training Performance Metrics (clearly distinguished)
  trainingPositionsAttempted Int    @default(0)
  trainingPositionsSolved    Int    @default(0)
  trainingSuccessRate        Float? // (solved / attempted) * 100

  // Weakness Progression (JSON)
  weaknessMetrics Json? // { [weakness]: { status: "IMPROVING"|"STABLE"|"WORSENING", baselineCpl, currentCpl } }

  // Associated System Versions
  chessDNAVersion         Int?
  currentSelfModelVersion Int?
  peakSelfModelVersion    Int?

  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, snapshotDate])
  @@index([userId, sourceType])
}

model ModelUpdateCandidate {
  id                          String   @id @default(cuid())
  userId                      String   @unique
  status                      String   @default("NO_UPDATE_NEEDED") // NO_UPDATE_NEEDED, NEW_DATA_AVAILABLE, RETRAINING_ELIGIBLE, CANDIDATE_READY
  currentSelfActiveVersion    Int      @default(1)
  peakSelfActiveVersion       Int      @default(1)
  newGamesSinceLastTrain      Int      @default(0)
  newPositionsSinceLastTrain  Int      @default(0)
  dnaDivergence               Float    @default(0.0)
  eligibilityReasons          Json? // Array of structured reasons/criteria
  candidateCurrentSelfVersion Int?
  candidatePeakSelfVersion    Int?
  retrainingJobId             String?
  activationStatus            String? // "PENDING", "ACTIVATED", "REJECTED"
  lastEvaluatedAt             DateTime @default(now())
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model ModelRetrainingJob {
  id                          String    @id @default(cuid())
  userId                      String
  triggeredBy                 String    @default("MANUAL") // MANUAL, ELIGIBILITY, SCHEDULED
  eligibilityCandidateId      String?
  sourceGameCount             Int       @default(0)
  sourceGameStart             DateTime?
  sourceGameEnd               DateTime?
  sourceDatasetVersion        String    @default("v2")
  featureVersion              String    @default("v1")
  trainingConfigVersion       String    @default("v1")
  currentModelVersion         Int       @default(1)
  candidateCurrentSelfVersion Int?
  candidatePeakSelfVersion    Int?
  currentSelfModelId          String?
  peakSelfModelId             String?
  status                      String    @default("QUEUED") // QUEUED, GENERATING_DATASET, TRAINING_CURRENT, EVALUATING_CURRENT, QUALITY_GATE_CURRENT, TRAINING_PEAK, EVALUATING_PEAK, QUALITY_GATE_PEAK, READY_FOR_ACTIVATION, ACTIVATING, COMPLETED, REJECTED, FAILED
  stage                       String    @default("QUEUED")
  progressPct                 Int       @default(0)
  currentGatePassed           Boolean?
  peakGatePassed              Boolean?
  isActivated                 Boolean   @default(false)
  gateReport                  Json?
  failureReason               String?   @db.Text
  rejectionReason             String?   @db.Text
  startedAt                   DateTime?
  completedAt                 DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, sourceDatasetVersion, currentModelVersion])
}
