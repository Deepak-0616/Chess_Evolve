# Supabase Connection (Public & Server Keys)
# Context account: Deepak-0616 (Do NOT hardcode in production application logic)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_BASE_URL=http://localhost:5000/api/v1

SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database Connections (Supabase PostgreSQL / Direct Pooler)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgboiler=true
DIRECT_DATABASE_URL=postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Server & Services Ports
PORT=5000
NODE_ENV=development
JWT_SECRET=your-fallback-jwt-secret-key-change-in-production

# Redis configuration (for BullMQ job processing)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ML Service URL
ML_SERVICE_URL=http://localhost:8000

# Stockfish Executable Path (leave empty if using built-in JS/WASM engine)
STOCKFISH_PATH=

# AI Coach OpenAI Key (Optional for natural language explanations)
OPENAI_API_KEY=
