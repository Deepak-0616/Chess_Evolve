datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chessProfile     ChessProfile?
  games            Game[]
  dnaVersions      ChessDNAVersion[]
  peakSelfVersions PeakSelfVersion[]
  playSessions     PlaySession[]
  trainingSessions TrainingSession[]
  syncJobs         SyncJob[]
}

model ChessProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  username        String    @unique
  profileUrl      String?
  avatarUrl       String?
  country         String?
  title           String?
  joinedAt        DateTime?
  lastSyncedAt    DateTime?
  gamesImported   Int       @default(0)
  gamesAnalyzed   Int       @default(0)
  dnaVersion      Int       @default(0)
  peakSelfVersion Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  games Game[]
}

model Game {
  id             String    @id @default(cuid())
  userId         String
  chessProfileId String
  externalId     String
  playedAt       DateTime?
  white          String
  black          String
  result         String
  playerColor    String
  playerRating   Int?
  opponentRating Int?
  timeControl    String?
  eco            String?
  openingName    String?
  pgn            String
  accuracy       Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chessProfile ChessProfile  @relation(fields: [chessProfileId], references: [id], onDelete: Cascade)
  moves        Move[]
  analysis     GameAnalysis?

  @@unique([chessProfileId, externalId])
  @@index([chessProfileId, playedAt])
  @@index([userId])
}

model Move {
  id         String  @id @default(cuid())
  gameId     String
  ply        Int
  moveNumber Int
  san        String
  uci        String
  fen        String?

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, ply])
}

model GameAnalysis {
  id               String   @id @default(cuid())
  gameId           String   @unique
  status           String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  depth            Int?     @default(12)
  playerAccuracy   Float?
  opponentAccuracy Float?
  blunders         Int      @default(0)
  mistakes         Int      @default(0)
  inaccuracies     Int      @default(0)
  analysisJson     String? // JSON stringified details (critical moments, move evals, etc.)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model ChessDNAVersion {
  id            String   @id @default(cuid())
  userId        String
  version       Int
  gamesAnalyzed Int
  metrics       String // JSON stringified {aggression, riskTaking, tacticalPreference, positionalPreference, defensiveAbility, endgameAbility, sacrificeTendency}
  strengths     String // JSON stringified array of strength objects
  weaknesses    String // JSON stringified array of weakness objects
  summaryText   String? // Natural language summary generated by analysis engine/LLM
  generatedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
}

model PeakSelfVersion {
  id              String   @id @default(cuid())
  userId          String
  version         Int
  dnaVersion      Int
  styleProfile    String // JSON stringified style metrics
  strengthProfile String // JSON stringified strength metrics
  configuration   String // JSON stringified engine tuning rules (stockfish search depth, aggression multiplier, weakness avoidance rules)
  generatedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
}

model PlaySession {
  id           String    @id @default(cuid())
  userId       String
  opponentType String // CURRENT_SELF or PEAK_SELF
  color        String // WHITE or BLACK
  status       String    @default("ACTIVE") // ACTIVE, COMPLETED, RESIGNED, DRAW
  fen          String    @default("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1")
  pgn          String    @default("")
  result       String? // WIN, LOSS, DRAW
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrainingSession {
  id             String    @id @default(cuid())
  userId         String
  category       String
  topic          String
  totalPositions Int
  correctAnswers Int       @default(0)
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts TrainingAttempt[]
}

model TrainingAttempt {
  id          String   @id @default(cuid())
  sessionId   String
  positionId  String
  correct     Boolean
  timeSpentMs Int
  createdAt   DateTime @default(now())

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SyncJob {
  id           String   @id @default(cuid())
  userId       String
  status       String   @default("QUEUED") // QUEUED, PROCESSING, COMPLETED, PARTIAL, FAILED
  currentStage String   @default("FETCHING_PROFILE") // FETCHING_PROFILE, FETCHING_ARCHIVES, IMPORTING_GAMES, PARSING_GAMES, ANALYZING_GAMES, COMPLETED
  progressJson String   @default("{}") // JSON details (archivesDiscovered, archivesProcessed, gamesDiscovered, gamesImported)
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
