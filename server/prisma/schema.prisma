datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String   @id @default(cuid())
  supabaseId        String?  @unique
  email             String   @unique
  passwordHash      String?
  displayName       String
  avatarUrl         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  chessProfile      ChessProfile?
  games             Game[]
  dnaVersions       ChessDNAVersion[]
  peakSelfVersions  PeakSelfVersion[]
  playSessions      PlaySession[]
  trainingSessions  TrainingSession[]
  syncJobs          SyncJob[]
  mlModelVersions   MLModelVersion[]
  weaknesses        Weakness[]
  evolutionEvents   EvolutionEvent[]
}

model MLModelVersion {
  id             String   @id @default(cuid())
  userId         String

  modelType      String   // CURRENT_SELF or PEAK_SELF
  version        Int

  dnaVersion     Int?

  gamesUsed      Int
  positionsUsed  Int

  status         String   // QUEUED, DATASET_GENERATING, TRAINING, VALIDATING, READY, FAILED, INSUFFICIENT_DATA

  metrics        String?  // JSON stringified { top1Accuracy, top3Accuracy, logLoss, precision, recall, f1Score, behavioralSimilarity }
  featureVersion String   @default("v1.0")

  artifactPath   String?
  configuration  String?  // JSON stringified hyperparams/weights

  trainedAt      DateTime?
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, modelType, version])
}

model ChessProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  username            String   @unique
  profileUrl          String?
  avatarUrl           String?
  country             String?
  title               String?
  joinedAt            DateTime?
  lastSyncedAt        DateTime?
  gamesImported       Int      @default(0)
  gamesAnalyzed       Int      @default(0)
  dnaVersion          Int      @default(0)
  peakSelfVersion     Int      @default(0)
  aiVisibility        String   @default("PUBLIC") // PRIVATE, DISCOVERABLE, PUBLIC
  aiRatingCurrentSelf Int      @default(1200)
  aiRatingPeakSelf    Int      @default(1400)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  games               Game[]
}

model Game {
  id               String   @id @default(cuid())
  userId           String
  chessProfileId   String
  externalId       String
  playedAt         DateTime?
  white            String
  black            String
  result           String
  playerColor      String
  playerRating     Int?
  opponentRating   Int?
  timeControl      String?
  eco              String?
  openingName      String?
  pgn              String
  accuracy         Float?
  syncSource       String   @default("CHESSCOM_PUBAPI")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  chessProfile     ChessProfile @relation(fields: [chessProfileId], references: [id], onDelete: Cascade)
  moves            Move[]
  analysis         GameAnalysis?

  @@unique([chessProfileId, externalId])
  @@index([chessProfileId, playedAt])
  @@index([userId])
}

model Move {
  id          String   @id @default(cuid())
  gameId      String
  ply         Int
  moveNumber  Int
  san         String
  uci         String
  fen         String?
  eval        Float?

  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, ply])
}

model GameAnalysis {
  id                    String   @id @default(cuid())
  gameId                String   @unique
  status                String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  depth                 Int?     @default(12)
  playerAccuracy        Float?
  opponentAccuracy      Float?
  blunders              Int      @default(0)
  mistakes              Int      @default(0)
  inaccuracies          Int      @default(0)
  analysisJson          String?  // JSON stringified details (critical moments, move evals, etc.)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  game                  Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model ChessDNAVersion {
  id                    String   @id @default(cuid())
  userId                String
  version               Int
  gamesAnalyzed         Int
  metrics               String   // JSON stringified DNA metrics
  strengths             String   // JSON stringified array of strength objects
  weaknesses            String   // JSON stringified array of weakness objects
  summaryText           String?  // Natural language summary
  generatedAt           DateTime @default(now())

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
}

model PeakSelfVersion {
  id                    String   @id @default(cuid())
  userId                String
  version               Int
  dnaVersion            Int
  styleProfile          String   // JSON stringified style metrics
  strengthProfile       String   // JSON stringified strength metrics
  configuration         String   // JSON stringified engine tuning rules
  generatedAt           DateTime @default(now())

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
}

model Weakness {
  id              String   @id @default(cuid())
  userId          String
  category        String   // TACTICAL, POSITIONAL, DEFENSIVE, OPENING, ENDGAME, TIME_PRESSURE
  pattern         String
  description     String
  evidenceCount   Int      @default(1)
  avgEvalLoss     Float    @default(0.0)
  exampleFen      String?
  detectedAt      DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlaySession {
  id                  String   @id @default(cuid())
  userId              String
  opponentUserId      String?  // null if playing self, or target userId if playing arena bot
  opponentType        String   // CURRENT_SELF or PEAK_SELF
  opponentModelVersion Int     @default(1)
  color               String   // WHITE or BLACK
  status              String   @default("ACTIVE") // ACTIVE, COMPLETED, RESIGNED, DRAW
  fen                 String   @default("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1")
  pgn                 String   @default("")
  result              String?  // WIN, LOSS, DRAW
  startedAt           DateTime @default(now())
  endedAt             DateTime?

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moves               PlayMove[]
}

model PlayMove {
  id            String   @id @default(cuid())
  sessionId     String
  ply           Int
  san           String
  uci           String
  fen           String
  isBot         Boolean  @default(false)
  createdAt     DateTime @default(now())

  session       PlaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model TrainingSession {
  id              String   @id @default(cuid())
  userId          String
  category        String
  topic           String
  totalPositions  Int
  correctAnswers  Int      @default(0)
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts        TrainingAttempt[]
}

model TrainingAttempt {
  id              String   @id @default(cuid())
  sessionId       String
  positionId      String
  correct         Boolean
  timeSpentMs     Int
  createdAt       DateTime @default(now())

  session         TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model EvolutionEvent {
  id              String   @id @default(cuid())
  userId          String
  eventType       String   // DNA_UPDATED, MODEL_TRAINED, RATING_MILESTONE, WEAKNESS_RESOLVED
  title           String
  description     String
  metricsSnapshot String?  // JSON stringified metrics
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SyncJob {
  id           String   @id @default(cuid())
  userId       String
  status       String   @default("QUEUED") // QUEUED, PROCESSING, COMPLETED, PARTIAL, FAILED
  currentStage String   @default("FETCHING_PROFILE") // FETCHING_PROFILE, FETCHING_ARCHIVES, IMPORTING_GAMES, PARSING_GAMES, ANALYZING_GAMES, COMPLETED
  progressJson String   @default("{}") // JSON details (archivesDiscovered, archivesProcessed, gamesDiscovered, gamesImported)
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
