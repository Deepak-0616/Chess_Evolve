# ==============================================================================
# Chess Evolve - Production Environment Template (.env.production.example)
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# Production CORS Origins (Replace with production domain)
CORS_ORIGINS=https://app.chessevolve.com

# Frontend Public Variables
VITE_SUPABASE_URL=https://prod-project.supabase.co
VITE_SUPABASE_ANON_KEY=prod-anon-key-placeholder
VITE_API_BASE_URL=https://api.chessevolve.com/api/v1

# Supabase Server Configuration
SUPABASE_URL=https://prod-project.supabase.co
SUPABASE_ANON_KEY=prod-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=prod-service-role-key-placeholder

# Production PostgreSQL Connection Strings (Connection pooler + direct for migrations)
DATABASE_URL=postgresql://postgres.xxx:prod-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_DATABASE_URL=postgresql://postgres.xxx:prod-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Production Redis Cluster / Upstash URL
REDIS_URL=rediss://default:prod-redis-password@prod-redis.internal:6379

# External Chess.com Public API Base URL
CHESS_API_BASE_URL=https://api.chess.com/pub

# Internal ML Service URL
ML_SERVICE_URL=http://ml-service.internal:8000
ML_SERVICE_PORT=8000
ML_SERVICE_AUTH_SECRET=prod-shared-ml-secret-placeholder
MODEL_STORAGE_PATH=/data/models

# Stockfish Binary Location in Production Container
STOCKFISH_PATH=/usr/games/stockfish

# AI Coach OpenAI Key
OPENAI_API_KEY=prod-openai-key-placeholder
