datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SyncStatus {
  IDLE
  SYNCING
  COMPLETED
  FAILED
}

enum MoveClassification {
  BEST
  GOOD
  INACCURACY
  MISTAKE
  BLUNDER
}

enum GamePhase {
  OPENING
  MIDDLEGAME
  ENDGAME
}

enum ModelType {
  CURRENT_SELF
  PEAK_SELF
}

enum ModelStatus {
  NOT_AVAILABLE
  INSUFFICIENT_DATA
  QUEUED
  TRAINING
  VALIDATING
  READY
  FAILED
}

enum PlaySessionStatus {
  IN_PROGRESS
  USER_WON
  MODEL_WON
  DRAW
  RESIGNED
}

enum ArenaVisibility {
  PRIVATE
  DISCOVERABLE
  PUBLIC
}

model User {
  id               String            @id // Matches Supabase Auth User UUID
  email            String?
  displayName      String?
  avatarUrl        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  chessProfile     ChessProfile?
  dnaVersions      ChessDNAVersion[]
  currentDna       ChessDNA?
  modelVersions    MLModelVersion[]
  trainingSessions TrainingSession[]
  playSessions     PlaySession[]
  arenaProfile     ArenaProfile?
  challengedSessions ArenaSession[] @relation("ChallengerSessions")
  featureJobs      FeatureGenerationJob[]
  featureDatasets  FeatureDataset[]
  featureRecords   FeatureRecord[]
  datasetJobs      DatasetGenerationJob[]
  datasets         MLDataset[]
  datasetRecords   MLDatasetRecord[]
}

model ChessProfile {
  id            String     @id @default(cuid())
  userId        String     @unique
  chessUsername String
  playerUrl     String?
  title         String?
  avatarUrl     String?
  country       String?
  followers     Int?
  joinedAt      DateTime?
  lastSyncedAt  DateTime?
  syncStatus    SyncStatus @default(IDLE)
  syncProgress  Json?      // Stores job state, processed games/archives count
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  games         Game[]
}

model Game {
  id               String       @id // External Chess.com game id or deterministic hash
  chessProfileId   String
  url              String?
  pgn              String       @db.Text
  timeControl      String
  timeClass        String       // bullet, blitz, rapid, daily
  rated            Boolean      @default(true)
  whiteUsername    String
  whiteRating      Int
  blackUsername    String
  blackRating      Int
  userColor        String       // WHITE or BLACK
  userRating       Int
  opponentUsername String
  opponentRating   Int
  result           String       // WIN, LOSS, DRAW
  endReason        String?
  playedAt         DateTime
  analyzed         Boolean      @default(false)
  createdAt        DateTime     @default(now())

  chessProfile     ChessProfile @relation(fields: [chessProfileId], references: [id], onDelete: Cascade)
  gameAnalysis     GameAnalysis?
  positionAnalyses PositionAnalysis[]

  @@index([chessProfileId, playedAt])
}

model GameAnalysis {
  id               String   @id @default(cuid())
  gameId           String   @unique
  accuracy         Float
  avgCpLoss        Float
  inaccuracies     Int
  mistakes         Int
  blunders         Int
  openingName      String?
  openingEco       String?
  openingAccuracy  Float?
  middlegameAccuracy Float?
  endgameAccuracy  Float?
  createdAt        DateTime @default(now())

  game             Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model PositionAnalysis {
  id               String             @id @default(cuid())
  gameId           String
  moveNumber       Int
  ply              Int
  fen              String
  move             String
  playerMove       Boolean            // True if made by connected user
  evalBefore       Float
  evalAfter        Float
  cpLoss           Float
  bestMove         String
  candidateMoves   Json               // Array of top K Stockfish candidates with evals
  classification   MoveClassification
  gamePhase        GamePhase
  materialBalance  Float
  kingSafetyScore  Float
  tacticalScore    Float
  positionalScore  Float
  createdAt        DateTime           @default(now())

  game             Game               @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, ply])
}

model ChessDNA {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  version                Int      @default(1)
  aggression             Float
  riskTaking             Float
  tacticalPreference     Float
  positionalPreference   Float
  defensiveAbility       Float
  sacrificeTendency      Float
  tradingTendency        Float
  openingDiversity       Float
  endgameAbility         Float
  kingSafety             Float
  attackPreference       Float
  simplificationPreference Float
  timePressureBehavior   Float
  topStrengths           Json     // Array of strength descriptors
  topWeaknesses          Json     // Array of weakness descriptors
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChessDNAVersion {
  id                     String   @id @default(cuid())
  userId                 String
  version                Int
  aggression             Float
  riskTaking             Float
  tacticalPreference     Float
  positionalPreference   Float
  defensiveAbility       Float
  sacrificeTendency      Float
  tradingTendency        Float
  openingDiversity       Float
  endgameAbility         Float
  kingSafety             Float
  attackPreference       Float
  simplificationPreference Float
  timePressureBehavior   Float
  createdAt              DateTime @default(now())

  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
}

model MLModelVersion {
  id                    String      @id @default(cuid())
  userId                String
  modelType             ModelType
  version               Int
  dnaVersion            Int?
  datasetVersion        String      @default("v1")
  featureVersion        String      @default("v1")
  architectureVersion   String      @default("v1")
  trainingConfigVersion String      @default("v1")
  trainingJobId         String?
  gamesUsed             Int         @default(0)
  positionsUsed         Int         @default(0)
  status                ModelStatus @default(NOT_AVAILABLE)
  metrics               Json?       // { accuracy, top3Accuracy, valLoss, epochCount, mrr }
  
  // Evaluation & Quality Gate
  evaluationStatus      String?     @default("PENDING")
  evaluationMetrics     Json?
  behavioralMetrics     Json?
  baselineMetrics       Json?
  qualityGateResult     Json?
  evaluationArtifactPath String?
  evaluationCompletedAt DateTime?
  
  artifactPath          String?
  artifactChecksum      String?
  trainedAt             DateTime?
  createdAt             DateTime    @default(now())

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  playSessions   PlaySession[]
  arenaSessions  ArenaSession[]

  @@unique([userId, modelType, version])
}

model TrainingSession {
  id             String    @id @default(cuid())
  userId         String
  targetWeakness String
  title          String
  description    String
  positions      Json      // Array of tactical/positional training puzzles
  score          Float?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlaySession {
  id                     String            @id @default(cuid())
  userId                 String
  opponentModelType      ModelType
  opponentModelVersionId String?
  userColor              String            // WHITE or BLACK
  fen                    String            @default("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1")
  pgn                    String            @default("") @db.Text
  moveHistory            Json              // Array of moves made in session
  status                 PlaySessionStatus @default(IN_PROGRESS)
  result                 String?           // USER_WIN, CURRENT_SELF_WIN, DRAW
  terminationReason      String?           // CHECKMATE, STALEMATE, RESIGNATION, etc.
  completedAt            DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  opponentModelVersion   MLModelVersion?   @relation(fields: [opponentModelVersionId], references: [id])
}

model ArenaProfile {
  id          String          @id @default(cuid())
  userId      String          @unique
  visibility  ArenaVisibility @default(PRIVATE)
  rating      Int             @default(1500)
  totalGames  Int             @default(0)
  wins        Int             @default(0)
  losses      Int             @default(0)
  draws       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetSessions ArenaSession[] @relation("TargetSessions")
}

model ArenaSession {
  id                     String            @id @default(cuid())
  challengerUserId       String
  targetUserId           String
  targetModelType        ModelType
  targetModelVersionId   String
  status                 PlaySessionStatus @default(IN_PROGRESS)
  pgn                    String            @default("") @db.Text
  fen                    String            @default("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1")
  moveHistory            Json
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  challengerUser         User              @relation("ChallengerSessions", fields: [challengerUserId], references: [id], onDelete: Cascade)
  targetArenaProfile     ArenaProfile      @relation("TargetSessions", fields: [targetUserId], references: [userId], onDelete: Cascade)
  targetModelVersion     MLModelVersion    @relation(fields: [targetModelVersionId], references: [id])
}

enum FeatureGenerationStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

model FeatureGenerationJob {
  id                    String                  @id @default(cuid())
  userId                String
  status                FeatureGenerationStatus @default(PENDING)
  featureVersion        String                  @default("v1")
  gamesTotal            Int                     @default(0)
  gamesProcessed        Int                     @default(0)
  positionsTotal        Int                     @default(0)
  positionsProcessed    Int                     @default(0)
  candidateRecordsGenerated Int                 @default(0)
  failedRecords         Int                     @default(0)
  startedAt             DateTime?
  completedAt           DateTime?
  error                 String?                 @db.Text
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FeatureDataset {
  id             String          @id @default(cuid())
  userId         String
  featureVersion String          @default("v1")
  gameCount      Int             @default(0)
  positionCount  Int             @default(0)
  candidateCount Int             @default(0)
  status         String          @default("READY")
  createdAt      DateTime        @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  records        FeatureRecord[]

  @@unique([userId, featureVersion])
}

model FeatureRecord {
  id               String          @id @default(cuid())
  featureDatasetId String
  userId           String
  gameId           String
  positionId       String          // Maps to PositionAnalysis ID
  moveNumber       Int
  candidateMove    String
  isActualMove     Boolean
  featureVersion   String
  
  // Stored conceptually as JSON for flexibility across dimensions
  position         Json
  candidate        Json
  player           Json
  history          Json
  weakness         Json
  dna              Json?

  createdAt        DateTime        @default(now())

  dataset          FeatureDataset  @relation(fields: [featureDatasetId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, positionId, candidateMove, featureVersion])
  @@index([userId, featureVersion])
  @@index([gameId])
}

enum DatasetStatus {
  PENDING
  RUNNING
  VALIDATING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum DatasetType {
  CURRENT_SELF
  PEAK_SELF
}

model DatasetGenerationJob {
  id                    String            @id @default(cuid())
  userId                String
  status                DatasetStatus     @default(PENDING)
  datasetType           DatasetType
  datasetVersion        String            @default("v1")
  featureVersion        String
  targetVersion         String            @default("v1")
  
  totalRecords          Int               @default(0)
  processedRecords      Int               @default(0)
  excludedRecords       Int               @default(0)
  
  startedAt             DateTime?
  completedAt           DateTime?
  error                 String?           @db.Text
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MLDataset {
  id                    String            @id @default(cuid())
  userId                String
  datasetType           DatasetType
  version               String
  featureVersion        String
  targetVersion         String
  schemaVersion         String            @default("v1")
  
  totalGames            Int               @default(0)
  totalPositions        Int               @default(0)
  totalRecords          Int               @default(0)
  
  trainRecords          Int               @default(0)
  validationRecords     Int               @default(0)
  testRecords           Int               @default(0)
  excludedRecords       Int               @default(0)
  
  status                DatasetStatus     @default(COMPLETED)
  validationReport      Json?
  statistics            Json?
  exclusionReasons      Json?
  
  createdAt             DateTime          @default(now())

  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  records               MLDatasetRecord[]
  
  @@unique([userId, datasetType, version])
}

model MLDatasetRecord {
  id               String      @id @default(cuid())
  datasetId        String
  userId           String
  gameId           String
  positionId       String
  moveNumber       Int
  split            String      // "TRAIN", "VALIDATION", "TEST"
  
  // Data
  candidateMove    String
  actualMove       String
  isActualMove     Boolean
  isPeakTarget     Boolean     @default(false)
  peakScore        Float?
  
  // Stored for easy artifact generation without complex joins
  features         Json
  metadata         Json
  
  createdAt        DateTime    @default(now())

  dataset          MLDataset   @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([datasetId, split])
  @@index([gameId])
}

