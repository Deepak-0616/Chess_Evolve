PORT=5000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
JWT_SECRET="your-jwt-secret-minimum-32-characters-placeholder"

DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

REDIS_URL="redis://localhost:6379"

STOCKFISH_PATH="/usr/local/bin/stockfish"
MODEL_STORAGE_PATH="./artifacts"
OPENAI_API_KEY="your-openai-api-key"
CHESS_API_BASE_URL="https://api.chess.com/pub"
ML_SERVICE_URL="http://localhost:8000"
