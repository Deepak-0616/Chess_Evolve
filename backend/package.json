{
  "name": "chess-evolve-backend",
  "version": "1.0.0",
  "description": "Chess Evolve Express API & Synchronization Engine",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "worker": "node src/worker.js",
    "prisma:generate": "prisma generate --schema=../prisma/schema.prisma",
    "prisma:db-push": "prisma db push --schema=../prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=../prisma/schema.prisma",
    "prisma:migrate:status": "prisma migrate status --schema=../prisma/schema.prisma",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@supabase/supabase-js": "^2.39.7",
    "axios": "^1.6.7",
    "bullmq": "^5.1.5",
    "chess.js": "^1.0.0-beta.6",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1",
    "stockfish": "^16.0.0",
    "swagger-ui-express": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "prisma": "^5.10.0",
    "supertest": "^6.3.4",
    "vitest": "^1.3.1"
  }
}
